# vhs tape: README demo — doctor, log, summary on vibebill's own repo.
# Regenerate with: vhs .github/demo.tape (from the repo root)
Output .github/demo.gif

Set Shell zsh
Set FontSize 15
Set Width 1200
Set Height 720
Set Padding 16
Set Theme "Builtin Dark"
Set TypingSpeed 45ms

Type "vibebill doctor"
Sleep 600ms
Enter
Sleep 5.5s

Type "vibebill log -n 8"
Sleep 600ms
Enter
Sleep 6s

Type "vibebill summary"
Sleep 600ms
Enter
Sleep 7s
